{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:qn-atlas:evaluator-proposal:v1",
  "title": "Scientific evaluator proposal (data only)",
  "type": "object",
  "required": [
    "schema_version",
    "author",
    "descriptor",
    "mathematical_definition",
    "scope_boundaries",
    "failure_counterconditions",
    "sources",
    "examples"
  ],
  "properties": {
    "schema_version": {
      "const": "evaluator_proposal_v1"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "descriptor": {
      "type": "object",
      "required": [
        "axis_id",
        "axis_version",
        "implementation_id",
        "implementation_version",
        "name",
        "output_kind",
        "scopes",
        "evidence_levels",
        "units",
        "dependencies",
        "projections",
        "projection_specs",
        "execution_contract"
      ],
      "properties": {
        "axis_id": {
          "type": "string",
          "minLength": 1
        },
        "axis_version": {
          "type": "string",
          "minLength": 1
        },
        "implementation_id": {
          "type": "string",
          "minLength": 1
        },
        "implementation_version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string",
          "minLength": 1
        },
        "output_kind": {
          "enum": [
            "scalar",
            "integer",
            "boolean",
            "categorical",
            "vector",
            "structured"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "equation",
              "domain",
              "trajectory",
              "sample",
              "algorithm"
            ]
          }
        },
        "evidence_levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "analytic",
              "interval",
              "numerical",
              "unknown"
            ]
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "projections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "projection_specs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "version",
              "units",
              "formula",
              "missing_policy",
              "output_kind"
            ]
          }
        },
        "execution_contract": {
          "type": "object",
          "required": [
            "input_schema",
            "output_schema",
            "failure_semantics",
            "resource_policy",
            "determinism",
            "implementation_sha256",
            "execution_mode"
          ],
          "properties": {
            "input_schema": {
              "type": "string",
              "minLength": 1
            },
            "output_schema": {
              "type": "string",
              "minLength": 1
            },
            "failure_semantics": {
              "type": "string",
              "minLength": 1
            },
            "resource_policy": {
              "type": "string",
              "minLength": 1
            },
            "determinism": {
              "type": "string",
              "minLength": 1
            },
            "implementation_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "execution_mode": {
              "const": "isolated_reviewed_runner"
            }
          }
        }
      }
    },
    "mathematical_definition": {
      "type": "string",
      "minLength": 1
    },
    "scope_boundaries": {
      "type": "string",
      "minLength": 1
    },
    "failure_counterconditions": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "locator",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "positive",
              "counterexample",
              "degenerate"
            ]
          },
          "input": {
            "type": "object"
          },
          "expected": {
            "type": "object",
            "required": [
              "status",
              "scope",
              "evidence_level",
              "relation",
              "derivation",
              "oracle",
              "counterclaim"
            ],
            "properties": {
              "status": {
                "enum": [
                  "known",
                  "estimated",
                  "unknown",
                  "not_applicable",
                  "unsupported",
                  "failed"
                ]
              },
              "scope": {
                "enum": [
                  "equation",
                  "domain",
                  "trajectory",
                  "sample",
                  "algorithm"
                ]
              },
              "evidence_level": {
                "enum": [
                  "analytic",
                  "interval",
                  "numerical",
                  "unknown"
                ]
              },
              "relation": {
                "enum": [
                  "equal",
                  "within_tolerance",
                  "interval_contains",
                  "status_only"
                ]
              },
              "derivation": {
                "type": "string",
                "minLength": 1
              },
              "oracle": {
                "type": "string",
                "minLength": 1
              },
              "counterclaim": {
                "type": "string",
                "minLength": 1
              },
              "absolute_tolerance": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "positive"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "counterexample"
              }
            },
            "required": [
              "role"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "role": {
                "const": "degenerate"
              }
            },
            "required": [
              "role"
            ]
          }
        }
      ]
    }
  },
  "$comment": "Additional scientific cross-field checks and authenticated external review/test evidence are required by qn_atlas.evaluator_review.validate_proposal. Schema success is not mathematical certification. No submitted code is executed."
}